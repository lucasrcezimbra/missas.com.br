#!/usr/bin/env bash
set -euo pipefail

readonly UV_VERSION="0.12.3"
readonly UV_BIN="$HOME/.local/bin/uv"

step() {
    printf '\n==> %s\n' "$1"
    SECONDS=0
}

done_step() {
    printf '    completed in %ss\n' "$SECONDS"
}

step "Installing the Python toolchain"
if [[ ! -x "$UV_BIN" ]] ||
    [[ "$("$UV_BIN" --version | cut -d ' ' -f 2)" != "$UV_VERSION" ]]; then
    curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" |
        env UV_UNMANAGED_INSTALL="$HOME/.local/bin" sh
fi
"$UV_BIN" python install 3.12
python_bin="$("$UV_BIN" python find 3.12)"
done_step

step "Installing Python dependencies"
"$UV_BIN" sync --locked --all-groups --python "$python_bin"
done_step

step "Installing Node.js dependencies"
for browser_dir in "$HOME/.cache/puppeteer/chrome"/linux-*; do
    if [[ -d "$browser_dir" && ! -x "$browser_dir/chrome-linux64/chrome" ]]; then
        rm -rf -- "$browser_dir"
    fi
done
for browser_dir in "$HOME/.cache/puppeteer/chrome-headless-shell"/linux-*; do
    if [[ -d "$browser_dir" &&
        ! -x "$browser_dir/chrome-headless-shell-linux64/chrome-headless-shell" ]]; then
        rm -rf -- "$browser_dir"
    fi
done
npm ci --no-audit --no-fund
done_step

step "Preparing the local environment and SQLite database"
if [[ ! -f .env ]]; then
    cp -- contrib/env-sample .env
fi
export DATABASE_URL="sqlite:///$PWD/db.sqlite3"
"$UV_BIN" run --no-sync python manage.py migrate --no-input
"$UV_BIN" run --no-sync python manage.py loaddata \
    missas/core/fixtures/states.json \
    missas/core/fixtures/cities.json \
    missas/core/fixtures/sources.json \
    missas/core/fixtures/parishes_natal.json \
    missas/core/fixtures/contacts_natal.json \
    missas/core/fixtures/locations_natal.json \
    missas/core/fixtures/schedules_natal.json
done_step

step "Preparing pre-commit hook environments"
"$UV_BIN" run --no-sync pre-commit install-hooks
done_step

printf '\nOrb setup complete.\n'
